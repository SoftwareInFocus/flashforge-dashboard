PRINTER_IP=
PRINTER_SERIAL=
PRINTER_CHECK_CODE=
# AD5X HTTP API default
PRINTER_PORT=8898

# Server-only social data configuration. Never use NEXT_PUBLIC_.
SOCIAL_SHEET_ID=
SOCIAL_SHEET_TAB="Muse Daily Scout"
# Absolute path to a private service account JSON file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Explicit sample mode, defaults off
SOCIAL_DEMO=false
# Optional path to an actual validated JSON snapshot (never a .gsheet pointer).
# Defaults to .local/social/workbook.json
SOCIAL_SNAPSHOT_PATH=

# Optional private GitHub data repo. If set, sync uses its workbook mirror.
SOCIAL_DATA_REPO=
# Optional full path to GitHub CLI; authentication stays in gh's local credential store.
GITHUB_CLI_PATH=
